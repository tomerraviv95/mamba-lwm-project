# Shared config for the BGU-HPC spectro jobs. Sourced by setup_env.sh and the *.sbatch scripts.
# Edit HF_USER (and anything else) once; everything else derives from it.

# cluster/config.env
export LD_LIBRARY_PATH=/home/ravivto/.conda/envs/mamba-build/lib:$LD_LIBRARY_PATH
export DRJIT_LIBLLVM_PATH=/home/ravivto/.conda/envs/mamba-build/lib/libLLVM.so

# ---- Hugging Face -----------------------------------------------------------------------
HF_USER="tomerraviv95"                               # <-- your Hugging Face username
HF_DATASET_REPO="${HF_USER}/lwm-spectro-synthetic"   # synthetic spectrogram corpus (dataset repo)
HF_MODEL_REPO="${HF_USER}/wimamba-spectro-ckpts"     # spectro MoE checkpoints (model repo)
HF_CHANNEL_REPO="${HF_USER}/wimamba-channel-ckpts"   # channel-domain LWM checkpoints (model repo)
HF_PRIVATE=1                                          # 1 = private repos

# HF_TOKEN is read from cluster/secrets.env (gitignored). See secrets.env.example.
if [ -f "$(dirname "${BASH_SOURCE[0]}")/secrets.env" ]; then
  # shellcheck disable=SC1091
  source "$(dirname "${BASH_SOURCE[0]}")/secrets.env"
fi

# ---- Dr.Jit / Mitsuba LLVM backend -----------------------------------------------------
# `import sionna` eagerly loads sionna.rt (Mitsuba/Dr.Jit), which needs libLLVM.so even though
# we only use sionna.phy. setup_env.sh normally persists DRJIT_LIBLLVM_PATH into secrets.env;
# this is a safe fallback that probes the conda build env if that wasn't done.
if [ -z "${DRJIT_LIBLLVM_PATH:-}" ]; then
  for _d in "$HOME/.conda/envs/mamba-build/lib" "$HOME/miniconda3/envs/mamba-build/lib" \
            "$HOME/anaconda3/envs/mamba-build/lib"; do
    _hit=$(ls "$_d"/libLLVM*.so* 2>/dev/null | head -n1 || true)
    if [ -n "$_hit" ]; then export DRJIT_LIBLLVM_PATH="$_hit"; break; fi
  done
fi

# ---- Python env (managed by uv) ---------------------------------------------------------
# The env is a uv-managed virtualenv at $REPO_ROOT/.venv, built from pyproject.toml + uv.lock
# by cluster/setup_env.sh. Jobs run scripts with `uv run --no-sync` (no network needed).

# ---- Paths (override if you keep data off the shared home, e.g. a /storage project dir) --
REPO_ROOT="${REPO_ROOT:-$HOME/lwm-competition-2025}"
DATA_DIR="${DATA_DIR:-$REPO_ROOT/spectro/outputs/synthetic}"
CKPT_DIR="${CKPT_DIR:-$REPO_ROOT/spectro/outputs/pretrained_models}"
CHANNEL_CKPT_DIR="${CHANNEL_CKPT_DIR:-$REPO_ROOT/outputs/pretrained_models/channel}"  # channel-domain ckpts

# ---- Channel-domain pretraining (DeepMIMO, 20 cities, ~10M tokens) ----------------------
TOKENS_PER_CITY=500000  # 20 cities x 500k ~= 10M patch-tokens (~116k channel realizations)

# ---- Generation -------------------------------------------------------------------------
PER_COMBO=500           # 315 combos x 500 ~= 157k samples
GEN_BATCH=16            # per-combo GPU batch (keep <=16 on 24GB; raise if exclusive GPU)
SEED=42

# ---- Pretraining (Mamba MoE) ------------------------------------------------------------
N_LAYERS=12
PRETRAIN_EPOCHS=40
ROUTER_EPOCHS=15
MASK_PERCENT=0.6
PRETRAIN_BATCH=16

# ---- Slurm ------------------------------------------------------------------------------
GPU_CONSTRAINT="rtx_3090"   # Ampere+ required for mamba-ssm (NOT gtx_1080)
