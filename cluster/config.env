# Shared config for the BGU-HPC spectro jobs. Sourced by setup_env.sh and the *.sbatch scripts.
# Edit HF_USER (and anything else) once; everything else derives from it.

# cluster/config.env
export LD_LIBRARY_PATH=/home/ravivto/.conda/envs/mamba-build/lib:${LD_LIBRARY_PATH:-}
export DRJIT_LIBLLVM_PATH=/home/ravivto/.conda/envs/mamba-build/lib/libLLVM.so

# ---- Hugging Face -----------------------------------------------------------------------
HF_USER="tomerraviv95"                               # <-- your Hugging Face username
HF_MODEL_REPO="${HF_MODEL_REPO:-${HF_USER}/wimamba-spectro-ckpts}"   # pretrained MoE checkpoints (model repo)
HF_RESULTS_REPO="${HF_RESULTS_REPO:-${HF_USER}/lwm-spectro-results}" # downstream sweep results (dataset repo)
HF_CORPUS_REPO="${HF_CORPUS_REPO:-${HF_USER}/lwm-spectro-alluser}"   # all-user 85/15 corpus+eval (dataset)
HF_GRIDSTFT_REPO="${HF_GRIDSTFT_REPO:-${HF_USER}/lwm-spectro-gridstft}" # held-out-cities eval lives here (dataset)
HF_PRIVATE="${HF_PRIVATE:-1}"                         # 1 = private repos
# xet transfer backend fails on the restricted cluster network -> force the classic HTTP path everywhere.
export HF_HUB_DISABLE_XET="${HF_HUB_DISABLE_XET:-1}"

# HF_TOKEN is read from cluster/secrets.env (gitignored). See secrets.env.example.
if [ -f "$(dirname "${BASH_SOURCE[0]}")/secrets.env" ]; then
  # shellcheck disable=SC1091
  source "$(dirname "${BASH_SOURCE[0]}")/secrets.env"
fi

# ---- Dr.Jit / Mitsuba LLVM backend -----------------------------------------------------
# `import sionna` eagerly loads sionna.rt (Mitsuba/Dr.Jit), which needs libLLVM.so even though
# we only use sionna.phy. setup_env.sh normally persists DRJIT_LIBLLVM_PATH into secrets.env;
# this is a safe fallback that probes the conda build env if that wasn't done.
if [ -z "${DRJIT_LIBLLVM_PATH:-}" ]; then
  for _d in "$HOME/.conda/envs/mamba-build/lib" "$HOME/miniconda3/envs/mamba-build/lib" \
            "$HOME/anaconda3/envs/mamba-build/lib"; do
    _hit=$(ls "$_d"/libLLVM*.so* 2>/dev/null | head -n1 || true)
    if [ -n "$_hit" ]; then export DRJIT_LIBLLVM_PATH="$_hit"; break; fi
  done
fi

# ---- Python env (managed by uv) ---------------------------------------------------------
# uv-managed virtualenv at $REPO_ROOT/.venv, built from pyproject.toml + uv.lock by
# cluster/setup_env.sh. Jobs run scripts with `uv run --no-sync` (no network needed).

# ---- Paths (override if you keep data off the shared home, e.g. a /storage project dir) --
# Repo root auto-detected as the parent of this cluster/ dir (works for any clone name/path).
REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
CKPT_DIR="${CKPT_DIR:-$REPO_ROOT/spectro/outputs/pretrained_models}"            # weights pushed to HF
# Paper-aligned corpus + downstream eval sets (dual [STFT|grid]).
CORPUS_DIR="${CORPUS_DIR:-$REPO_ROOT/spectro/outputs/spectro_deepmimo_alluser85_gridstft}"  # 85%-user pretrain
EVAL_INDIST_DIR="${EVAL_INDIST_DIR:-$REPO_ROOT/spectro/outputs/spectro_eval_alluser15_gridstft}"     # 15%-user (in-distribution)
EVAL_XENV_DIR="${EVAL_XENV_DIR:-$REPO_ROOT/spectro/outputs/spectro_eval_heldout_cities_gridstft}"    # held-out cities (cross-env)
# THE downstream dataset that gets the 70/10/20 train/val/test split (finetune + baselines run on this).
# Default = in-distribution 15%-user eval (2-channel [STFT|grid], matches the pretrained backbones; the
# real 1-channel demo set is architecturally incompatible). Point at EVAL_XENV_DIR for the cross-env cut.
DOWNSTREAM_DIR="${DOWNSTREAM_DIR:-$EVAL_INDIST_DIR}"

# ---- Pretraining (PAPER recipe: reconstruction-ONLY; eq. 21) ------------------------------
# Pretraining loss = W_MLM*MLM (masked spectrogram modeling). Supervised contrastive is a
# FINE-TUNING-stage loss (eq. 22) and lives in spectro_finetune.py, NOT here -> W_CONT=0.
# Paper Table I: mask 70%, lambda_recon=1.0, AdamW wd=0.05, lr 5e-4 warmup->cosine 1e-8, patch 4x4.
N_LAYERS=12
ROUTER_EPOCHS=15
MASK_PERCENT=0.7
SPECTRO_W_MLM=1.0
SPECTRO_W_CONT="${SPECTRO_W_CONT:-0.0}"        # 0 = reconstruction-only pretraining (paper)
SPECTRO_TEMP=0.2
SPECTRO_LR=5e-4
SPECTRO_MIN_LR=1e-8
SPECTRO_WD=0.05
SPECTRO_WARMUP=0.1     # fraction of STEPS for linear warmup (step-based real pretrainer)
SEED=42
SPECTRO_STEPS="${SPECTRO_STEPS:-5000}"         # optimizer steps PER expert. At batch 128 this = 640k
                                               # presentations/expert (~14.5 epochs of the ~44k/expert
                                               # slice) = 1.7x the data of the old 12k-step/batch-32 run,
                                               # which plateaued by ~4-6k steps. So 5k @ batch128 is past
                                               # the plateau (with margin).
SPECTRO_EVAL_EVERY="${SPECTRO_EVAL_EVERY:-1000}"  # in-corpus probe cadence (5 probes over 5k steps)
SPECTRO_EVAL_TASK="${SPECTRO_EVAL_TASK:-modulation}"
# checkpoints/results tagged spectro_{arch}_p{patch}_{suffix}_weights. NOTE the sbatch skips pretraining
# if that dir already has 3 experts + router -> bump this suffix for a NEW recipe so it can't silently
# reuse old checkpoints. `alluser_b128` = the batch-128 / no-accum / 5k-step run (keeps the old batch-32
# `alluser` checkpoints intact for comparison).
WEIGHTS_SUFFIX="${WEIGHTS_SUFFIX:-alluser_b128}"
PATCHES="${PATCHES:-4 8}"                      # patch sizes swept by every run (pretrain + downstream + baselines)
SPECTRO_POOL="${SPECTRO_POOL:-meanstd_t}"      # pooling for the --head mlp fallback (CNN head ignores it)
# TRUE batch 128, NO grad accumulation, for BOTH arches (removes the accum confound; apples-to-apples).
# Feasible on a 24GB 3090 because the transformer now uses memory-efficient SDPA attention
# (spectro/hf_cache/pretraining/pretrained_model.py) instead of materializing the (B,heads,seq,seq) scores.
TF_BATCH="${TF_BATCH:-128}";  TF_ACCUM="${TF_ACCUM:-1}"
MAMBA_BATCH="${MAMBA_BATCH:-128}"; MAMBA_ACCUM="${MAMBA_ACCUM:-1}"

# ---- Downstream (70/10/20 split; 1-D CNN head; macro-F1; TOTAL-samples few-shot axis) -----
# Everything (LoRA-finetune + baselines) runs on DOWNSTREAM_DIR with the SAME stratified 70/10/20 split:
# train on N of {SAMPLE_COUNTS} drawn from the 70% pool, val=10% (early-stop), test=fixed 20%.
DOWNSTREAM_HEAD="${DOWNSTREAM_HEAD:-cnn1d}"    # residual-1D-CNN head over the token sequence
DOWNSTREAM_TAG="${DOWNSTREAM_TAG:-indist15}"   # labels the eval set in submission dir names (set to
                                               # 'xenv' when DOWNSTREAM_DIR=EVAL_XENV_DIR so runs don't collide)
SAMPLE_COUNTS="${SAMPLE_COUNTS:-50 100 200 400 600}"   # TOTAL training samples (few-shot axis)
DOWNSTREAM_SEEDS="${DOWNSTREAM_SEEDS:-42 43 44}"
HEAD_RESTARTS="${HEAD_RESTARTS:-3}"            # best-of-N head inits (baselines, rejects collapsed low-n)
VAL_FRAC="${VAL_FRAC:-0.10}"; TEST_FRAC="${TEST_FRAC:-0.20}"
# LoRA finetune (spectro_finetune.py): adapters capped at LORA_BUDGET of the backbone; head trainable.
LORA_BUDGET="${LORA_BUDGET:-0.05}"
LORA_MAX_RANK="${LORA_MAX_RANK:-16}"
FT_EPOCHS="${FT_EPOCHS:-30}"
FT_PATIENCE="${FT_PATIENCE:-8}"
FT_BATCH="${FT_BATCH:-16}"
FT_W_RECON="${FT_W_RECON:-1.0}"; FT_W_CONT="${FT_W_CONT:-0.3}"   # eq.22 joint-loss weights (finetune stage)
# No-pretrain baselines (spectro_train_heads.py). random_init is run per moe-arch so each untrained
# backbone is a control for its arm; resnet18 is a frozen ImageNet feature extractor.
BASELINES="${BASELINES:-deepcnn random_init raw resnet18}"

# ---- Weights & Biases -------------------------------------------------------------------
WANDB_PROJECT="${WANDB_PROJECT:-lwm-spectro}"  # set WANDB_API_KEY in secrets.env (login-node sync)
# Compute nodes have no usable internet on this cluster, so log OFFLINE by default and
# `wandb sync cluster/logs/wandb/offline-*` on the login node. Override WANDB_MODE=online if a node
# does have egress. WANDB_DIR keeps the offline runs inside the repo for easy syncing.
export WANDB_MODE="${WANDB_MODE:-offline}"
export WANDB_DIR="${WANDB_DIR:-$REPO_ROOT/cluster/logs}"

# ---- Slurm ------------------------------------------------------------------------------
GPU_CONSTRAINT="rtx_3090"   # Ampere+ required for mamba-ssm (NOT gtx_1080)
