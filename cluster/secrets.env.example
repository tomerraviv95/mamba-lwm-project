# Copy this file to `secrets.env` (gitignored) and fill in your token:
#     cp cluster/secrets.env.example cluster/secrets.env
#     nano cluster/secrets.env
#
# Create a WRITE token at: https://huggingface.co/settings/tokens
# config.env auto-sources this file, and huggingface_hub auto-uses HF_TOKEN.

export HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Alternative to a token file: run once on the login node and skip secrets.env entirely:
#     huggingface-cli login            # caches the token in ~/.cache/huggingface (shared home)
